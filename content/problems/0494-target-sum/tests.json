{
  "compare": "exact",
  "cases": [
    {
      "name": "five ones",
      "args": [
        [
          1,
          1,
          1,
          1,
          1
        ],
        3
      ],
      "expected": 5
    },
    {
      "name": "single positive",
      "args": [
        [
          1
        ],
        1
      ],
      "expected": 1
    },
    {
      "name": "single negative",
      "args": [
        [
          1
        ],
        -1
      ],
      "expected": 1
    },
    {
      "name": "single unreachable",
      "args": [
        [
          1
        ],
        0
      ],
      "expected": 0
    },
    {
      "name": "single zero",
      "args": [
        [
          0
        ],
        0
      ],
      "expected": 2
    },
    {
      "name": "three zeros",
      "args": [
        [
          0,
          0,
          0
        ],
        0
      ],
      "expected": 8
    },
    {
      "name": "subset split",
      "args": [
        [
          1,
          2,
          3
        ],
        0
      ],
      "expected": 2
    },
    {
      "name": "parity impossible",
      "args": [
        [
          2,
          3,
          5
        ],
        1
      ],
      "expected": 0
    },
    {
      "name": "empty list",
      "args": [
        [],
        0
      ],
      "expected": 1
    },
    {
      "name": "zero with a one",
      "args": [
        [
          1,
          0
        ],
        1
      ],
      "expected": 2
    }
  ]
}
