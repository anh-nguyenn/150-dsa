{
  "compare": "exact",
  "result_adapter": "tree",
  "cases": [
    {
      "name": "sample tree",
      "args": [
        [
          3,
          9,
          20,
          15,
          7
        ],
        [
          9,
          3,
          15,
          20,
          7
        ]
      ],
      "expected": [
        3,
        9,
        20,
        null,
        null,
        15,
        7
      ]
    },
    {
      "name": "single node",
      "args": [
        [
          -1
        ],
        [
          -1
        ]
      ],
      "expected": [
        -1
      ]
    },
    {
      "name": "left child",
      "args": [
        [
          1,
          2
        ],
        [
          2,
          1
        ]
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "name": "right child",
      "args": [
        [
          1,
          2
        ],
        [
          1,
          2
        ]
      ],
      "expected": [
        1,
        null,
        2
      ]
    },
    {
      "name": "root with two leaves",
      "args": [
        [
          1,
          2,
          3
        ],
        [
          2,
          1,
          3
        ]
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "name": "perfect seven nodes",
      "args": [
        [
          1,
          2,
          4,
          5,
          3,
          6,
          7
        ],
        [
          4,
          2,
          5,
          1,
          6,
          3,
          7
        ]
      ],
      "expected": [
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ]
    }
  ]
}
