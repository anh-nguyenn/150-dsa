{
  "compare": "exact",
  "result": "arg0",
  "result_adapter": "linked_list",
  "cases": [
    {
      "name": "even length",
      "args": [
        {
          "linked_list": [
            1,
            2,
            3,
            4
          ]
        }
      ],
      "expected": [
        1,
        4,
        2,
        3
      ]
    },
    {
      "name": "odd length",
      "args": [
        {
          "linked_list": [
            1,
            2,
            3,
            4,
            5
          ]
        }
      ],
      "expected": [
        1,
        5,
        2,
        4,
        3
      ]
    },
    {
      "name": "single node",
      "args": [
        {
          "linked_list": [
            1
          ]
        }
      ],
      "expected": [
        1
      ]
    },
    {
      "name": "empty list",
      "args": [
        {
          "linked_list": []
        }
      ],
      "expected": []
    },
    {
      "name": "two nodes",
      "args": [
        {
          "linked_list": [
            1,
            2
          ]
        }
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "name": "three nodes",
      "args": [
        {
          "linked_list": [
            1,
            2,
            3
          ]
        }
      ],
      "expected": [
        1,
        3,
        2
      ]
    }
  ]
}
