{
  "compare": "exact",
  "cases": [
    {
      "name": "two words",
      "args": [
        "leetcode",
        [
          "leet",
          "code"
        ]
      ],
      "expected": true
    },
    {
      "name": "repeated word",
      "args": [
        "applepenapple",
        [
          "apple",
          "pen"
        ]
      ],
      "expected": true
    },
    {
      "name": "not separable",
      "args": [
        "catsandog",
        [
          "cats",
          "dog",
          "sand",
          "and",
          "cat"
        ]
      ],
      "expected": false
    },
    {
      "name": "single match",
      "args": [
        "a",
        [
          "a"
        ]
      ],
      "expected": true
    },
    {
      "name": "single miss",
      "args": [
        "a",
        [
          "b"
        ]
      ],
      "expected": false
    },
    {
      "name": "repeated characters",
      "args": [
        "aaaaaaa",
        [
          "aaaa",
          "aaa"
        ]
      ],
      "expected": true
    },
    {
      "name": "two pieces",
      "args": [
        "cars",
        [
          "car",
          "ca",
          "rs"
        ]
      ],
      "expected": true
    },
    {
      "name": "duplicate letters",
      "args": [
        "bb",
        [
          "a",
          "b",
          "bbb",
          "bbbb"
        ]
      ],
      "expected": true
    }
  ]
}
