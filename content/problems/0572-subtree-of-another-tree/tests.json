{
  "compare": "exact",
  "cases": [
    {
      "name": "matching left branch",
      "args": [
        {
          "tree": [
            3,
            4,
            5,
            1,
            2
          ]
        },
        {
          "tree": [
            4,
            1,
            2
          ]
        }
      ],
      "expected": true
    },
    {
      "name": "extra node breaks match",
      "args": [
        {
          "tree": [
            3,
            4,
            5,
            1,
            2,
            null,
            null,
            null,
            null,
            0
          ]
        },
        {
          "tree": [
            4,
            1,
            2
          ]
        }
      ],
      "expected": false
    },
    {
      "name": "single node match",
      "args": [
        {
          "tree": [
            1
          ]
        },
        {
          "tree": [
            1
          ]
        }
      ],
      "expected": true
    },
    {
      "name": "single node mismatch",
      "args": [
        {
          "tree": [
            1
          ]
        },
        {
          "tree": [
            2
          ]
        }
      ],
      "expected": false
    },
    {
      "name": "leaf as subtree",
      "args": [
        {
          "tree": [
            1,
            2,
            3
          ]
        },
        {
          "tree": [
            2
          ]
        }
      ],
      "expected": true
    },
    {
      "name": "wrong child position",
      "args": [
        {
          "tree": [
            1,
            2,
            3
          ]
        },
        {
          "tree": [
            2,
            3
          ]
        }
      ],
      "expected": false
    },
    {
      "name": "match in perfect tree",
      "args": [
        {
          "tree": [
            1,
            2,
            3,
            4,
            5,
            6,
            7
          ]
        },
        {
          "tree": [
            3,
            6,
            7
          ]
        }
      ],
      "expected": true
    }
  ]
}
