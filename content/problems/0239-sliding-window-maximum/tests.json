{
  "compare": "exact",
  "cases": [
    {
      "name": "typical",
      "args": [
        [
          1,
          3,
          -1,
          -3,
          5,
          3,
          6,
          7
        ],
        3
      ],
      "expected": [
        3,
        3,
        5,
        5,
        6,
        7
      ]
    },
    {
      "name": "single element",
      "args": [
        [
          1
        ],
        1
      ],
      "expected": [
        1
      ]
    },
    {
      "name": "window one",
      "args": [
        [
          1,
          -1
        ],
        1
      ],
      "expected": [
        1,
        -1
      ]
    },
    {
      "name": "two elements",
      "args": [
        [
          9,
          11
        ],
        2
      ],
      "expected": [
        11
      ]
    },
    {
      "name": "negative values",
      "args": [
        [
          4,
          -2
        ],
        2
      ],
      "expected": [
        4
      ]
    },
    {
      "name": "mixed short",
      "args": [
        [
          7,
          2,
          4
        ],
        2
      ],
      "expected": [
        7,
        4
      ]
    },
    {
      "name": "window crosses dips",
      "args": [
        [
          1,
          3,
          1,
          2,
          0,
          5
        ],
        3
      ],
      "expected": [
        3,
        3,
        2,
        5
      ]
    },
    {
      "name": "full-length window",
      "args": [
        [
          5,
          1,
          3
        ],
        3
      ],
      "expected": [
        5
      ]
    }
  ]
}
