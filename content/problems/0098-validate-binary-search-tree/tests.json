{
  "compare": "exact",
  "cases": [
    {
      "name": "small valid tree",
      "args": [
        {
          "tree": [
            2,
            1,
            3
          ]
        }
      ],
      "expected": true
    },
    {
      "name": "grandchild violates ancestor",
      "args": [
        {
          "tree": [
            5,
            1,
            4,
            null,
            null,
            3,
            6
          ]
        }
      ],
      "expected": false
    },
    {
      "name": "single node",
      "args": [
        {
          "tree": [
            1
          ]
        }
      ],
      "expected": true
    },
    {
      "name": "duplicate values",
      "args": [
        {
          "tree": [
            2,
            2,
            2
          ]
        }
      ],
      "expected": false
    },
    {
      "name": "deep right branch violation",
      "args": [
        {
          "tree": [
            5,
            4,
            6,
            null,
            null,
            3,
            7
          ]
        }
      ],
      "expected": false
    },
    {
      "name": "valid seven nodes",
      "args": [
        {
          "tree": [
            3,
            1,
            5,
            0,
            2,
            4,
            6
          ]
        }
      ],
      "expected": true
    },
    {
      "name": "minimum integer value",
      "args": [
        {
          "tree": [
            -2147483648
          ]
        }
      ],
      "expected": true
    }
  ]
}
