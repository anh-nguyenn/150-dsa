{
  "compare": "unordered_deep",
  "cases": [
    {
      "name": "reuse and single value",
      "args": [
        [
          2,
          3,
          6,
          7
        ],
        7
      ],
      "expected": [
        [
          2,
          2,
          3
        ],
        [
          7
        ]
      ]
    },
    {
      "name": "several combinations",
      "args": [
        [
          2,
          3,
          5
        ],
        8
      ],
      "expected": [
        [
          2,
          2,
          2,
          2
        ],
        [
          2,
          3,
          3
        ],
        [
          3,
          5
        ]
      ]
    },
    {
      "name": "candidate too large",
      "args": [
        [
          2
        ],
        1
      ],
      "expected": []
    },
    {
      "name": "repeat a single candidate",
      "args": [
        [
          1
        ],
        2
      ],
      "expected": [
        [
          1,
          1
        ]
      ]
    },
    {
      "name": "no exact total",
      "args": [
        [
          3,
          5
        ],
        4
      ],
      "expected": []
    },
    {
      "name": "even target",
      "args": [
        [
          2
        ],
        4
      ],
      "expected": [
        [
          2,
          2
        ]
      ]
    }
  ]
}
