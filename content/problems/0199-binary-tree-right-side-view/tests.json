{
  "compare": "exact",
  "cases": [
    {
      "name": "sample tree",
      "args": [
        {
          "tree": [
            1,
            2,
            3,
            null,
            5,
            null,
            4
          ]
        }
      ],
      "expected": [
        1,
        3,
        4
      ]
    },
    {
      "name": "right child only",
      "args": [
        {
          "tree": [
            1,
            null,
            3
          ]
        }
      ],
      "expected": [
        1,
        3
      ]
    },
    {
      "name": "left child only",
      "args": [
        {
          "tree": [
            1,
            2
          ]
        }
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "name": "left child exposed on last level",
      "args": [
        {
          "tree": [
            1,
            2,
            3,
            4
          ]
        }
      ],
      "expected": [
        1,
        3,
        4
      ]
    },
    {
      "name": "deep left branch",
      "args": [
        {
          "tree": [
            1,
            2,
            3,
            null,
            5
          ]
        }
      ],
      "expected": [
        1,
        3,
        5
      ]
    },
    {
      "name": "single node",
      "args": [
        {
          "tree": [
            1
          ]
        }
      ],
      "expected": [
        1
      ]
    }
  ]
}
