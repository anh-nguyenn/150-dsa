{
  "compare": "exact",
  "result_adapter": "tree",
  "cases": [
    {
      "name": "balanced sample",
      "args": [
        {
          "tree": [
            4,
            2,
            7,
            1,
            3,
            6,
            9
          ]
        }
      ],
      "expected": [
        4,
        7,
        2,
        9,
        6,
        3,
        1
      ]
    },
    {
      "name": "empty tree",
      "args": [
        {
          "tree": []
        }
      ],
      "expected": []
    },
    {
      "name": "single node",
      "args": [
        {
          "tree": [
            1
          ]
        }
      ],
      "expected": [
        1
      ]
    },
    {
      "name": "left child only",
      "args": [
        {
          "tree": [
            1,
            2
          ]
        }
      ],
      "expected": [
        1,
        null,
        2
      ]
    },
    {
      "name": "perfect tree",
      "args": [
        {
          "tree": [
            1,
            2,
            3,
            4,
            5,
            6,
            7
          ]
        }
      ],
      "expected": [
        1,
        3,
        2,
        7,
        6,
        5,
        4
      ]
    },
    {
      "name": "negative values",
      "args": [
        {
          "tree": [
            0,
            -1,
            3,
            null,
            2
          ]
        }
      ],
      "expected": [
        0,
        3,
        -1,
        null,
        null,
        2
      ]
    }
  ]
}
