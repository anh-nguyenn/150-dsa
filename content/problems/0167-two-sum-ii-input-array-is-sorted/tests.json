{
  "compare": "exact",
  "cases": [
    {
      "name": "typical",
      "args": [
        [
          2,
          7,
          11,
          15
        ],
        9
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "name": "three values",
      "args": [
        [
          2,
          3,
          4
        ],
        6
      ],
      "expected": [
        1,
        3
      ]
    },
    {
      "name": "negative pair",
      "args": [
        [
          -1,
          0
        ],
        -1
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "name": "duplicate values",
      "args": [
        [
          1,
          2,
          3,
          4,
          4,
          9
        ],
        8
      ],
      "expected": [
        4,
        5
      ]
    },
    {
      "name": "answer at the end",
      "args": [
        [
          5,
          25,
          75
        ],
        100
      ],
      "expected": [
        2,
        3
      ]
    },
    {
      "name": "minimum length",
      "args": [
        [
          1,
          2
        ],
        3
      ],
      "expected": [
        1,
        2
      ]
    }
  ]
}
