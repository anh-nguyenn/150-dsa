{
  "compare": "exact",
  "cases": [
    {
      "name": "classic",
      "args": [
        [
          10,
          9,
          2,
          5,
          3,
          7,
          101,
          18
        ]
      ],
      "expected": 4
    },
    {
      "name": "nonzero prefix",
      "args": [
        [
          0,
          1,
          0,
          3,
          2,
          3
        ]
      ],
      "expected": 4
    },
    {
      "name": "all equal",
      "args": [
        [
          7,
          7,
          7,
          7
        ]
      ],
      "expected": 1
    },
    {
      "name": "single element",
      "args": [
        [
          1
        ]
      ],
      "expected": 1
    },
    {
      "name": "decreasing",
      "args": [
        [
          5,
          4,
          3,
          2,
          1
        ]
      ],
      "expected": 1
    },
    {
      "name": "long chain",
      "args": [
        [
          1,
          3,
          6,
          7,
          9,
          4,
          10,
          5,
          6
        ]
      ],
      "expected": 6
    },
    {
      "name": "duplicate pair",
      "args": [
        [
          2,
          2
        ]
      ],
      "expected": 1
    }
  ]
}
