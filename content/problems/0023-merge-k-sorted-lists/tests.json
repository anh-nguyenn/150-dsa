{
  "compare": "exact",
  "result_adapter": "linked_list",
  "cases": [
    {
      "name": "three interleaved lists",
      "args": [
        [
          {
            "linked_list": [
              1,
              4,
              5
            ]
          },
          {
            "linked_list": [
              1,
              3,
              4
            ]
          },
          {
            "linked_list": [
              2,
              6
            ]
          }
        ]
      ],
      "expected": [
        1,
        1,
        2,
        3,
        4,
        4,
        5,
        6
      ]
    },
    {
      "name": "no lists",
      "args": [
        []
      ],
      "expected": []
    },
    {
      "name": "one empty list",
      "args": [
        [
          {
            "linked_list": []
          }
        ]
      ],
      "expected": []
    },
    {
      "name": "empty plus nonempty",
      "args": [
        [
          {
            "linked_list": []
          },
          {
            "linked_list": [
              1
            ]
          }
        ]
      ],
      "expected": [
        1
      ]
    },
    {
      "name": "single list",
      "args": [
        [
          {
            "linked_list": [
              1,
              2,
              3
            ]
          }
        ]
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "name": "negatives with gaps",
      "args": [
        [
          {
            "linked_list": [
              -5,
              -1
            ]
          },
          {
            "linked_list": [
              -4,
              0
            ]
          },
          {
            "linked_list": [
              -3,
              2
            ]
          }
        ]
      ],
      "expected": [
        -5,
        -4,
        -3,
        -1,
        0,
        2
      ]
    },
    {
      "name": "duplicate values",
      "args": [
        [
          {
            "linked_list": [
              1,
              1
            ]
          },
          {
            "linked_list": [
              1,
              1
            ]
          }
        ]
      ],
      "expected": [
        1,
        1,
        1,
        1
      ]
    }
  ]
}
