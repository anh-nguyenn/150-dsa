{
  "compare": "exact",
  "cases": [
    {
      "name": "typical",
      "args": [
        [
          2,
          7,
          11,
          15
        ],
        9
      ],
      "expected": [
        0,
        1
      ]
    },
    {
      "name": "middle pair",
      "args": [
        [
          3,
          2,
          4
        ],
        6
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "name": "duplicate values",
      "args": [
        [
          3,
          3
        ],
        6
      ],
      "expected": [
        0,
        1
      ]
    },
    {
      "name": "negative values",
      "args": [
        [
          -1,
          -2,
          -3,
          -4
        ],
        -6
      ],
      "expected": [
        1,
        3
      ]
    },
    {
      "name": "minimum length",
      "args": [
        [
          0,
          4
        ],
        4
      ],
      "expected": [
        0,
        1
      ]
    }
  ]
}
