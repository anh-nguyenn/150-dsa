{
  "compare": "exact",
  "cases": [
    {
      "name": "target in middle",
      "args": [
        [
          -1,
          0,
          3,
          5,
          9,
          12
        ],
        9
      ],
      "expected": 4
    },
    {
      "name": "target absent",
      "args": [
        [
          -1,
          0,
          3,
          5,
          9,
          12
        ],
        2
      ],
      "expected": -1
    },
    {
      "name": "single match",
      "args": [
        [
          1
        ],
        1
      ],
      "expected": 0
    },
    {
      "name": "single miss",
      "args": [
        [
          1
        ],
        0
      ],
      "expected": -1
    },
    {
      "name": "first element",
      "args": [
        [
          1,
          3,
          5,
          7,
          9
        ],
        1
      ],
      "expected": 0
    },
    {
      "name": "last element",
      "args": [
        [
          1,
          3,
          5,
          7,
          9
        ],
        9
      ],
      "expected": 4
    },
    {
      "name": "even length",
      "args": [
        [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        4
      ],
      "expected": 3
    },
    {
      "name": "below range",
      "args": [
        [
          -5,
          -2,
          0,
          4
        ],
        -6
      ],
      "expected": -1
    }
  ]
}
