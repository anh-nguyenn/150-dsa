{
  "compare": "exact",
  "result_adapter": "linked_list",
  "cases": [
    {
      "name": "interleaved",
      "args": [
        {
          "linked_list": [
            1,
            2,
            4
          ]
        },
        {
          "linked_list": [
            1,
            3,
            4
          ]
        }
      ],
      "expected": [
        1,
        1,
        2,
        3,
        4,
        4
      ]
    },
    {
      "name": "both empty",
      "args": [
        {
          "linked_list": []
        },
        {
          "linked_list": []
        }
      ],
      "expected": []
    },
    {
      "name": "first empty",
      "args": [
        {
          "linked_list": []
        },
        {
          "linked_list": [
            0
          ]
        }
      ],
      "expected": [
        0
      ]
    },
    {
      "name": "second empty",
      "args": [
        {
          "linked_list": [
            5
          ]
        },
        {
          "linked_list": []
        }
      ],
      "expected": [
        5
      ]
    },
    {
      "name": "no interleaving",
      "args": [
        {
          "linked_list": [
            1,
            2,
            3
          ]
        },
        {
          "linked_list": [
            4,
            5,
            6
          ]
        }
      ],
      "expected": [
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    {
      "name": "duplicates and negatives",
      "args": [
        {
          "linked_list": [
            -3,
            -1
          ]
        },
        {
          "linked_list": [
            -2,
            -1,
            0
          ]
        }
      ],
      "expected": [
        -3,
        -2,
        -1,
        -1,
        0
      ]
    }
  ]
}
