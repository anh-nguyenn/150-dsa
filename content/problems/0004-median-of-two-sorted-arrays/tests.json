{
  "compare": "float",
  "tolerance": 1e-06,
  "cases": [
    {
      "name": "odd total",
      "args": [
        [
          1,
          3
        ],
        [
          2
        ]
      ],
      "expected": 2.0
    },
    {
      "name": "even total",
      "args": [
        [
          1,
          2
        ],
        [
          3,
          4
        ]
      ],
      "expected": 2.5
    },
    {
      "name": "empty first",
      "args": [
        [],
        [
          1
        ]
      ],
      "expected": 1.0
    },
    {
      "name": "empty second",
      "args": [
        [
          2
        ],
        []
      ],
      "expected": 2.0
    },
    {
      "name": "even disjoint",
      "args": [
        [
          1,
          2,
          3
        ],
        [
          4,
          5,
          6
        ]
      ],
      "expected": 3.5
    },
    {
      "name": "all zeros",
      "args": [
        [
          0,
          0
        ],
        [
          0,
          0
        ]
      ],
      "expected": 0.0
    },
    {
      "name": "interleaved even",
      "args": [
        [
          1,
          3,
          5,
          7
        ],
        [
          2,
          4,
          6,
          8
        ]
      ],
      "expected": 4.5
    },
    {
      "name": "uneven lengths",
      "args": [
        [
          1,
          2
        ],
        [
          3,
          4,
          5,
          6
        ]
      ],
      "expected": 3.5
    },
    {
      "name": "large adjacent values",
      "args": [
        [
          100000
        ],
        [
          100001
        ]
      ],
      "expected": 100000.5
    },
    {
      "name": "duplicates odd",
      "args": [
        [
          1,
          1
        ],
        [
          1
        ]
      ],
      "expected": 1.0
    }
  ]
}
