{
  "compare": "exact",
  "cases": [
    {
      "name": "classic",
      "args": [
        [
          3,
          2,
          1,
          5,
          6,
          4
        ],
        2
      ],
      "expected": 5
    },
    {
      "name": "duplicates",
      "args": [
        [
          3,
          2,
          3,
          1,
          2,
          4,
          5,
          5,
          6
        ],
        4
      ],
      "expected": 4
    },
    {
      "name": "single element",
      "args": [
        [
          1
        ],
        1
      ],
      "expected": 1
    },
    {
      "name": "negative values",
      "args": [
        [
          -1,
          -2,
          -3
        ],
        2
      ],
      "expected": -2
    },
    {
      "name": "all equal",
      "args": [
        [
          5,
          5,
          5
        ],
        3
      ],
      "expected": 5
    },
    {
      "name": "descending order",
      "args": [
        [
          7,
          6,
          5,
          4,
          3,
          2,
          1
        ],
        5
      ],
      "expected": 3
    }
  ]
}
