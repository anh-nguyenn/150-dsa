{
  "compare": "exact",
  "cases": [
    {
      "name": "multiply after add",
      "args": [
        [
          "2",
          "1",
          "+",
          "3",
          "*"
        ]
      ],
      "expected": 9
    },
    {
      "name": "divide then add",
      "args": [
        [
          "4",
          "13",
          "5",
          "/",
          "+"
        ]
      ],
      "expected": 6
    },
    {
      "name": "long expression",
      "args": [
        [
          "10",
          "6",
          "9",
          "3",
          "+",
          "-11",
          "*",
          "/",
          "*",
          "17",
          "+",
          "5",
          "+"
        ]
      ],
      "expected": 22
    },
    {
      "name": "single number",
      "args": [
        [
          "18"
        ]
      ],
      "expected": 18
    },
    {
      "name": "negative division",
      "args": [
        [
          "7",
          "-2",
          "/"
        ]
      ],
      "expected": -3
    },
    {
      "name": "negative numerator division",
      "args": [
        [
          "-7",
          "2",
          "/"
        ]
      ],
      "expected": -3
    },
    {
      "name": "operand order subtraction",
      "args": [
        [
          "1",
          "5",
          "-"
        ]
      ],
      "expected": -4
    },
    {
      "name": "negative multiplication",
      "args": [
        [
          "-3",
          "-4",
          "*"
        ]
      ],
      "expected": 12
    }
  ]
}
