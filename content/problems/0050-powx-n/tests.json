{
  "compare": "float",
  "cases": [
    {
      "name": "positive exponent",
      "args": [
        2.0,
        10
      ],
      "expected": 1024.0
    },
    {
      "name": "fractional base",
      "args": [
        2.1,
        3
      ],
      "expected": 9.261
    },
    {
      "name": "negative exponent",
      "args": [
        2.0,
        -2
      ],
      "expected": 0.25
    },
    {
      "name": "zero exponent",
      "args": [
        1.0,
        0
      ],
      "expected": 1.0
    },
    {
      "name": "negative base odd",
      "args": [
        -2.0,
        3
      ],
      "expected": -8.0
    },
    {
      "name": "negative base even",
      "args": [
        -3.0,
        2
      ],
      "expected": 9.0
    },
    {
      "name": "fractional negative exponent",
      "args": [
        0.5,
        -3
      ],
      "expected": 8.0
    }
  ]
}
