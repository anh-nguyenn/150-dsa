{
  "compare": "exact",
  "cases": [
    {
      "name": "identical small trees",
      "args": [
        {
          "tree": [
            1,
            2,
            3
          ]
        },
        {
          "tree": [
            1,
            2,
            3
          ]
        }
      ],
      "expected": true
    },
    {
      "name": "left versus right child",
      "args": [
        {
          "tree": [
            1,
            2
          ]
        },
        {
          "tree": [
            1,
            null,
            2
          ]
        }
      ],
      "expected": false
    },
    {
      "name": "swapped values",
      "args": [
        {
          "tree": [
            1,
            2,
            1
          ]
        },
        {
          "tree": [
            1,
            1,
            2
          ]
        }
      ],
      "expected": false
    },
    {
      "name": "both empty",
      "args": [
        {
          "tree": []
        },
        {
          "tree": []
        }
      ],
      "expected": true
    },
    {
      "name": "one empty",
      "args": [
        {
          "tree": []
        },
        {
          "tree": [
            0
          ]
        }
      ],
      "expected": false
    },
    {
      "name": "deeper identical trees",
      "args": [
        {
          "tree": [
            1,
            2,
            3,
            4
          ]
        },
        {
          "tree": [
            1,
            2,
            3,
            4
          ]
        }
      ],
      "expected": true
    },
    {
      "name": "different shape at depth",
      "args": [
        {
          "tree": [
            1,
            2,
            3,
            null,
            4
          ]
        },
        {
          "tree": [
            1,
            2,
            3,
            4
          ]
        }
      ],
      "expected": false
    }
  ]
}
