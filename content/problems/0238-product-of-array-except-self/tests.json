{
  "compare": "exact",
  "cases": [
    {
      "name": "typical",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": [
        24,
        12,
        8,
        6
      ]
    },
    {
      "name": "single zero",
      "args": [
        [
          -1,
          1,
          0,
          -3,
          3
        ]
      ],
      "expected": [
        0,
        0,
        9,
        0,
        0
      ]
    },
    {
      "name": "two zeros",
      "args": [
        [
          0,
          0
        ]
      ],
      "expected": [
        0,
        0
      ]
    },
    {
      "name": "two elements",
      "args": [
        [
          2,
          3
        ]
      ],
      "expected": [
        3,
        2
      ]
    },
    {
      "name": "zero in the middle",
      "args": [
        [
          1,
          2,
          0,
          4,
          5
        ]
      ],
      "expected": [
        0,
        0,
        40,
        0,
        0
      ]
    },
    {
      "name": "ones and a five",
      "args": [
        [
          5,
          1,
          1,
          1
        ]
      ],
      "expected": [
        1,
        5,
        5,
        5
      ]
    },
    {
      "name": "mixed signs",
      "args": [
        [
          2,
          -1,
          -3,
          4
        ]
      ],
      "expected": [
        12,
        -24,
        -8,
        6
      ]
    }
  ]
}
